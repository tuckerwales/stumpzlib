# Copy to .env and source it, or pass these as environment variables directly.

# Required: the directory Stump scans, as THIS process sees it.
# If Stump runs in Docker, use the host path, not the in-container path.
LIBRARY_PATH=/srv/books

# Where this app listens.
LISTEN=:8080

# Your Stump server.
STUMP_URL=http://localhost:10801

# Authenticate with an API key...
STUMP_API_KEY=

# ...or with a username and password (ignored if STUMP_API_KEY is set).
STUMP_USERNAME=
STUMP_PASSWORD=

# Library to rescan after each add. Leave blank to skip rescans — Stump will
# still find new files on its next scheduled scan.
# Run the app and open /api/status to list your libraries and their ids.
STUMP_LIBRARY_ID=

# Require a login to use this app at all. Leave both blank to run without
# authentication (fine only if you're relying on network-level protection
# instead — see the README).
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional overrides.
GUTENDEX_URL=https://gutendex.com
MAX_DOWNLOAD_MB=200

# Z-library (optional). Search works without an account; downloads need one.
# Leave ZLIBRARY_URL blank and use Auto-discover on the Settings page if you
# don't know a working mirror.
ZLIBRARY_URL=
ZLIBRARY_EMAIL=
ZLIBRARY_PASSWORD=
